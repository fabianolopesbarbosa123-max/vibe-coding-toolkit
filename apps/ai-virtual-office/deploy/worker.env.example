# Template for /etc/ai-office/worker.env on the worker host. Copy, fill on the server, never commit.
# chown root:aioffice /etc/ai-office/worker.env && chmod 0640 /etc/ai-office/worker.env

# Session pooler (IPv4) as shown in Supabase > Connect > Session pooler, with the worker role:
#   user = office_worker_prod1.<PROJECT-REF>, password percent-encoded if it has special characters.
# verify-full + the Supabase CA certificate (Database Settings > SSL Configuration > Download certificate).
WORKER_DATABASE_URL=postgresql://office_worker_prod1.<PROJECT-REF>:<PASSWORD>@<POOLER-HOST>:5432/postgres?sslmode=verify-full&sslrootcert=/etc/ai-office/supabase-ca.crt

# Claude API key from the Claude Console (only the worker needs it).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Keep these identical on the web server and every worker.
OFFICE_DEFAULT_MONTHLY_BUDGET_USD=10
OFFICE_DEFAULT_MONTHLY_TOKEN_LIMIT=2000000
OFFICE_DEFAULT_DAILY_REQUEST_LIMIT=100
OFFICE_DEFAULT_MAX_CONCURRENT_RUNS=2

WORKER_CONCURRENCY=2
WORKER_LEASE_SECONDS=60
NODE_ENV=production
