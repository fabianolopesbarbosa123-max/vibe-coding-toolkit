# Copy to .env.local. Never commit real keys. All keys are read on the server only.

# Claude API (required for the CEO planner and the default agents)
ANTHROPIC_API_KEY=
# Optional override; agents can also set their own model.
ANTHROPIC_MODEL=claude-opus-5-5

# OpenAI API (optional; agents set to "OpenAI API" stay unavailable until both are set)
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional USD prices per million tokens, used only for cost estimates.
OPENAI_INPUT_PRICE_PER_MTOK=
OPENAI_OUTPUT_PRICE_PER_MTOK=

# Supabase (optional). Without it, data is stored in .data/office.json for local development.
# Apply supabase/migrations/0001_initial.sql first. The service-role key must stay server-side.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Local JSON store path (used only when Supabase is not configured)
OFFICE_DATA_FILE=.data/office.json
