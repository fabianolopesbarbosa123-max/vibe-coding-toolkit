# Copy to .env.local. Never commit real keys. Only NEXT_PUBLIC_* values reach the browser.

# Supabase (required for multi-user mode: auth, database, realtime, storage).
# Local stack: run `npm run db:start` and copy API_URL and PUBLISHABLE_KEY from `npx supabase status`.
# Cloud: Project Settings > API. The publishable (anon) key is public by design; RLS protects the data.
# NEVER put the service-role / secret key here: the app does not need it.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Public site URL used for auth redirects in production (e.g. https://office.example.com).
NEXT_PUBLIC_SITE_URL=

# Single-user development mode without Supabase (data in OFFICE_DATA_FILE). Ignored when Supabase is set.
OFFICE_LOCAL_MODE=false
OFFICE_DATA_FILE=.data/office.json

# ---------------------------------------------------------------------------------------------
# AI providers: configured centrally in src/server/ai/config.ts and read ONLY on the server.
# These are the operator's keys; users never see them. Per-user usage is limited below.
# ---------------------------------------------------------------------------------------------
# Claude API (required for the CEO planner and the default agents). Server-only.
# Supabase mode: set it on the queue WORKER only; the web server reads availability from the workers.
# Local mode (OFFICE_LOCAL_MODE): set it here, since the web server makes the calls.
ANTHROPIC_API_KEY=
# Optional override; agents can also set their own model.
ANTHROPIC_MODEL=claude-opus-5-5

# OpenAI API (optional; agents set to "OpenAI API" stay unavailable until both are set). Server-only.
OPENAI_API_KEY=
OPENAI_MODEL=
# USD per million tokens from your OpenAI price list. Without them OpenAI calls are unpriced
# and only allowed when a token limit applies.
OPENAI_INPUT_PRICE_PER_MTOK=
OPENAI_OUTPUT_PRICE_PER_MTOK=

# Models agents may use (comma-separated). Default: Claude models with a known price, plus OPENAI_MODEL.
OFFICE_ALLOWED_MODELS=

# Default per-user limits (app defaults, not provider limits). Use "unlimited" to disable one.
# Per-user overrides: insert/update rows in public.usage_limits (see docs/supabase.md).
OFFICE_DEFAULT_MONTHLY_BUDGET_USD=10
OFFICE_DEFAULT_MONTHLY_TOKEN_LIMIT=2000000
OFFICE_DEFAULT_DAILY_REQUEST_LIMIT=100
OFFICE_DEFAULT_MAX_CONCURRENT_RUNS=2
# Running work with no progress for this many minutes is marked failed so it can be retried.
OFFICE_STALE_AFTER_MINUTES=20

# ---------------------------------------------------------------------------------------------
# Execution queue worker (npm run worker; separate process). See docs/execution-engine.md.
# A Postgres login role that is a member of office_worker. Never the postgres user or the
# service-role key. Read only by the worker process.
WORKER_DATABASE_URL=
WORKER_CONCURRENCY=2
WORKER_LEASE_SECONDS=60
WORKER_POLL_MS=2000
